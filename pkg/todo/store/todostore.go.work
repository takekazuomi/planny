package store

import (
	"context"
	"errors"
	"fmt"
	"time"

	"github.com/google/uuid"
	todov1 "github.com/takekazu/planny/pkg/gen/planny/todo/v1"
	"github.com/takekazu/planny/pkg/x/store"
	"google.golang.org/protobuf/types/known/timestamppb"
)

type TodoStore = store.KeyValueStore[string, *todov1.Todo]

// TodoKeyValueStore は Todo アイテムに特化したKey-Valueストアを実装します
type TodoKeyValueStore struct {
	// Todoアイテムのデータストア（キーはTodo名）
	data map[string]*todov1.Todo
}

// NewTodoKeyValueStore は新しいTodoKeyValueStoreのインスタンスを作成します
func NewTodoKeyValueStore() *TodoKeyValueStore {
	return &TodoKeyValueStore{
		data: make(map[string]*todov1.Todo, 100),
	}
}

// Get は指定された名前（キー）のTodoアイテムを取得します
func (s *TodoKeyValueStore) Get(ctx context.Context, key string) (*todov1.Todo, error) {
	todo, exists := s.data[key]
	if !exists {
		return nil, errors.New("key not found")
	}
	return todo, nil
}

// Set は指定された名前（キー）にTodoアイテムを設定します
func (s *TodoKeyValueStore) Set(ctx context.Context, key string, value *todov1.Todo) error {
	s.data[key] = value
	return nil
}

// Delete は指定された名前（キー）のTodoアイテムを削除します
func (s *TodoKeyValueStore) Delete(ctx context.Context, key string) error {
	if _, exists := s.data[key]; !exists {
		return errors.New("key not found")
	}
	delete(s.data, key)
	return nil
}

// List は全てのTodoアイテムを取得します
func (s *TodoKeyValueStore) List(ctx context.Context) ([]*todov1.Todo, error) {
	todos := make([]*todov1.Todo, 0, len(s.data))
	for _, todo := range s.data {
		todos = append(todos, todo)
	}
	return todos, nil
}

// Has は指定された名前（キー）が存在するか確認します
func (s *TodoKeyValueStore) Has(ctx context.Context, key string) bool {
	_, exists := s.data[key]
	return exists
}

// グローバルなTodoKeyValueStore
var globalTodoKVStore = NewTodoKeyValueStore()

// GetTodoKeyValueStore はグローバルなTodoKeyValueStoreのインスタンスを返します
func GetTodoKeyValueStore() *TodoKeyValueStore {
	return globalTodoKVStore
}

// TodoStoreInterface は Todo アイテムの操作に必要な基本的なメソッドを定義します
type TodoStoreInterface interface {
	// Create は新しい Todo アイテムを作成します
	Create(ctx context.Context, todo *todov1.Todo) (*todov1.Todo, error)

	// Update は既存の Todo アイテムを更新します
	Update(ctx context.Context, name string, todo *todov1.Todo) (*todov1.Todo, error)

	// Delete は Todo アイテムを論理削除します
	Delete(ctx context.Context, name string) (*todov1.Todo, error)

	// Undelete は論理削除された Todo アイテムを復元します
	Undelete(ctx context.Context, name string) (*todov1.Todo, error)

	// Get は指定された名前の Todo アイテムを取得します
	Get(ctx context.Context, name string) (*todov1.Todo, error)

	// List は条件に合った Todo アイテムの一覧を取得します
	List(ctx context.Context, showDeleted bool) ([]*todov1.Todo, error)
}

// Store は Todo アイテムのインメモリストアを実装します
type Store struct {
	// Todoアイテムのデータストア（キーはTodo名）
	todoData map[string]*todov1.Todo
}

// グローバルなTodoデータストア
var todoData = Store{
	todoData: make(map[string]*todov1.Todo, 100),
}

// GetStore はグローバルな Todo ストアのインスタンスを返します
func GetStore() *Store {
	return &todoData
}

// Create は新しい Todo アイテムを作成します
func (s *Store) Create(ctx context.Context, todo *todov1.Todo) (*todov1.Todo, error) {
	// 一意なIDを生成
	id := fmt.Sprintf("todos/%s", uuid.New().String())

	// 現在時刻を取得
	now := timestamppb.Now()
	// 30日後の期限を設定（デフォルト）
	dueDate := timestamppb.New(time.Now().Add(30 * 24 * time.Hour))

	// 新しいTodoアイテムを作成
	newTodo := &todov1.Todo{
		Name:        id,
		Title:       todo.Title,
		Description: todo.Description,
		Priority:    0, // デフォルト優先度
		Status:      todov1.TodoStatus_TODO_STATUS_ACTIVE,
		DueDate:     dueDate,
		CreatedAt:   now,
		UpdatedAt:   now,
	}

	// ストアに保存
	s.todoData[id] = newTodo

	return newTodo, nil
}

// Update は既存の Todo アイテムを更新します
func (s *Store) Update(ctx context.Context, name string, todo *todov1.Todo) (*todov1.Todo, error) {
	// 名前が存在するか確認
	existingTodo, exists := s.todoData[name]
	if !exists {
		return nil, errors.New("todo not found")
	}

	// 削除されたアイテムは更新できない
	if existingTodo.DeletedAt != nil {
		return nil, errors.New("cannot update deleted todo")
	}

	// 更新する値を設定
	if todo.Title != "" {
		existingTodo.Title = todo.Title
	}
	if todo.Description != "" {
		existingTodo.Description = todo.Description
	}

	// 更新時刻を更新
	existingTodo.UpdatedAt = timestamppb.Now()

	return existingTodo, nil
}

// Delete は Todo アイテムを論理削除します
func (s *Store) Delete(ctx context.Context, name string) (*todov1.Todo, error) {
	// 名前が存在するか確認
	existingTodo, exists := s.todoData[name]
	if !exists {
		return nil, errors.New("todo not found")
	}

	// すでに削除されている場合
	if existingTodo.DeletedAt != nil {
		return nil, errors.New("todo already deleted")
	}

	// 論理削除を行う
	existingTodo.DeletedAt = timestamppb.Now()
	existingTodo.Status = todov1.TodoStatus_TODO_STATUS_REVOKED
	existingTodo.UpdatedAt = timestamppb.Now()

	return existingTodo, nil
}

// Undelete は論理削除された Todo アイテムを復元します
func (s *Store) Undelete(ctx context.Context, name string) (*todov1.Todo, error) {
	// 名前が存在するか確認
	existingTodo, exists := s.todoData[name]
	if !exists {
		return nil, errors.New("todo not found")
	}

	// 削除されていない場合
	if existingTodo.DeletedAt == nil {
		return nil, errors.New("todo is not deleted")
	}

	// 論理削除を解除
	existingTodo.DeletedAt = nil
	existingTodo.Status = todov1.TodoStatus_TODO_STATUS_ACTIVE
	existingTodo.UpdatedAt = timestamppb.Now()

	return existingTodo, nil
}

// Get は指定された名前の Todo アイテムを取得します
func (s *Store) Get(ctx context.Context, name string) (*todov1.Todo, error) {
	// 名前が存在するか確認
	todo, exists := s.todoData[name]
	if !exists {
		return nil, errors.New("todo not found")
	}

	return todo, nil
}

// List は条件に合った Todo アイテムの一覧を取得します
func (s *Store) List(ctx context.Context, showDeleted bool) ([]*todov1.Todo, error) {
	todos := make([]*todov1.Todo, 0, len(s.todoData))

	// 全てのTodoアイテムをループ
	for _, todo := range s.todoData {
		// 削除されたアイテムを表示するかどうか
		if !showDeleted && todo.DeletedAt != nil {
			continue
		}
		todos = append(todos, todo)
	}

	return todos, nil
}
